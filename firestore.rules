rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.token.admin == true; }
  match /articles/{id} {
   allow read: if admin() || resource.data.status == 'published';
   allow create, update: if admin()
    && request.resource.data.keys().hasOnly(['title','excerpt','category','cover','coverAlt','blocks','status','publishedAt','updatedAt'])
    && request.resource.data.title is string
    && request.resource.data.title.size() > 0
    && request.resource.data.title.size() <= 180
    && request.resource.data.excerpt is string
    && request.resource.data.excerpt.size() > 0
    && request.resource.data.excerpt.size() <= 500
    && request.resource.data.cover is string
    && request.resource.data.cover.size() > 0
    && request.resource.data.coverAlt is string
    && (request.resource.data.publishedAt == null || request.resource.data.publishedAt is timestamp)
    && (request.resource.data.status != 'published' || request.resource.data.publishedAt is timestamp)
    && request.resource.data.blocks is list
    && request.resource.data.blocks.size() > 0
    && request.resource.data.blocks.size() <= 100
    && request.resource.data.category in ['Kegiatan','Akademik','Organisasi','Prestasi','Pengumuman']
    && request.resource.data.status in ['draft','published']
    && request.resource.data.updatedAt == request.time;
   allow delete: if admin();
  }
 }
}
